# Copy to .env and fill in. Never commit real secrets.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DB"
# Only used by the automated tests (a separate, disposable database)
TEST_DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DB_TEST"
# 32+ random characters. Signs staff and customer session cookies.
AUTH_SECRET=""
# Public base URL, e.g. https://diwaanshahkhwaan.onrender.com
APP_URL="http://localhost:3000"

# Payments: "stripe" (Stripe TEST keys only until the owner approves live) or "demo"
# (built-in simulated payment page for staging; never takes money)
PAYMENT_PROVIDER="demo"
DEMO_PAYMENT_SECRET=""
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
# Must be set to "true" in addition to live keys before live Stripe keys are accepted
ALLOW_LIVE_PAYMENTS="false"

# Email: "console" (logs only) or "resend"
EMAIL_PROVIDER="console"
RESEND_API_KEY=""
EMAIL_FROM="Diwaan Shah Khwaan <orders@yourdomain.com.au>"
# SMS: "none" or "twilio"
SMS_PROVIDER="none"
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM=""

# Protects /api/cron/* (background jobs, hold expiry). Send as: Authorization: Bearer <CRON_SECRET>
CRON_SECRET=""
# Run the background job worker inside the web process (recommended on Render)
IN_PROCESS_WORKER="true"

# Used once by `npm run db:seed` to create the first owner login
SEED_OWNER_EMAIL=""
SEED_OWNER_PASSWORD=""

# Set to "true" only on the production domain so search engines index it
SITE_INDEXABLE="false"
