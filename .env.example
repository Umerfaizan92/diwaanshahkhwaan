# ─────────────────────────────────────────────────────────────────────────────
# Diwaan Shah Khwaan — environment variables
# Copy to `.env` for local development. On Render, add these under
# Service → Environment. NEVER commit real values or paste them into chats.
# ─────────────────────────────────────────────────────────────────────────────

# ── Core (required) ─────────────────────────────────────────────────────────
# Postgres connection string. On Render this is filled in from the database automatically.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/diwaanshahkhwaan"
# "true" to force SSL for the database (auto-on when the URL contains sslmode=require)
DATABASE_SSL="false"
# Max database connections per server (default 10; keep low on small plans)
DATABASE_POOL_MAX="5"
# 32+ random characters. Signs sign-in cookies and hashes one-time codes.
# Generate: openssl rand -base64 48   (Render's blueprint generates it for you)
AUTH_SECRET=""
# The public web address. Used in emails, receipts, order links and the sitemap.
APP_URL="https://www.diwaan.com.au"

# ── Owner login (first deploy only, optional) ───────────────────────────────
# Either set these once to create the owner login automatically, OR leave them
# empty and use "Set up the owner account" on /admin/login (code sent to the
# business mobile and email). Password: 12+ characters.
SEED_OWNER_EMAIL=""
SEED_OWNER_PASSWORD=""

# ── Payments ────────────────────────────────────────────────────────────────
# "demo" = built-in simulated payment page (never takes money; for testing)
# "stripe" = real Stripe Checkout (hosted, PCI-compliant card page)
PAYMENT_PROVIDER="demo"
# Secret for the demo payment page (any 32+ random characters)
DEMO_PAYMENT_SECRET=""
# Stripe → Developers → API keys. Use sk_test_… first; sk_live_… only after owner approval.
STRIPE_SECRET_KEY="sk_test_..."
# Stripe → Developers → Webhooks → endpoint https://www.diwaan.com.au/api/payments/webhook/stripe
# Events: checkout.session.completed, checkout.session.async_payment_succeeded,
#         checkout.session.async_payment_failed, checkout.session.expired,
#         refund.created, refund.updated
STRIPE_WEBHOOK_SECRET="whsec_..."
# Live Stripe keys are refused unless this is "true" (owner's explicit go-live approval)
ALLOW_LIVE_PAYMENTS="false"

# ── Email (order confirmations, receipts, owner alerts, sign-in codes) ──────
# "console" = only written to the server log; "resend" = really sent (resend.com)
EMAIL_PROVIDER="console"
RESEND_API_KEY=""
# Must use a domain verified in Resend, e.g. orders@diwaan.com.au
EMAIL_FROM="Diwaan Shah Khwaan <orders@diwaan.com.au>"

# ── SMS (owner new-order texts, customer texts, sign-in codes) ──────────────
# "none" or "twilio" (twilio.com)
SMS_PROVIDER="none"
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
# Your Twilio sender: an Australian number (+61…) or approved alphanumeric sender ID
TWILIO_FROM=""

# ── Background jobs ─────────────────────────────────────────────────────────
# Runs the notification queue, payment-hold expiry and reminders inside the web server (recommended)
IN_PROCESS_WORKER="true"
# Protects /api/cron/sweep for an optional external scheduler: Authorization: Bearer <CRON_SECRET>
CRON_SECRET=""

# ── SEO and search engines ──────────────────────────────────────────────────
# "true" only on the final live domain, so Google and Bing may list the site.
# Requires PAYMENT_PROVIDER=stripe (the server refuses to index a site using demo payments).
SITE_INDEXABLE="false"
# Google Search Console → HTML tag method → the content="…" value
GOOGLE_SITE_VERIFICATION=""
# Bing Webmaster Tools → meta tag → the content="…" value
BING_SITE_VERIFICATION=""
# Comma-separated public profile links (Google Business, Facebook, Instagram, TikTok)
SOCIAL_LINKS=""

# ── Server tuning (Render) ──────────────────────────────────────────────────
# Node version on Render
NODE_VERSION="22"
# Heap for the build step; the running server is capped at 256 MB in `npm run start:render`
NODE_OPTIONS="--max-old-space-size=1536"
# Keeps memory use low on small instances
MALLOC_ARENA_MAX="2"
# Emergency switch only: "true" turns off the Content-Security-Policy header
DISABLE_CSP="false"

# ── Automated tests only (not needed on Render) ─────────────────────────────
# A separate, disposable database — its name must contain "test"
TEST_DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/diwaanshahkhwaan_test"
# Address the end-to-end tests open (a running production build)
BASE_URL="http://localhost:3000"
